{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "baseBranches": [
    "main",
    "0.x"
  ],
  "fetchChangeLogs": "off",
  "prBodyNotes": [],
  "prConcurrentLimit": 10,
  "prHourlyLimit": 5,
  "packageRules": [
    {
      "description": "Disable all Python language version updates",
      "matchPackageNames": [
        "python"
      ],
      "enabled": false
    },
    {
      "description": "Python Manager (pyproject.toml)",
      "matchManagers": [
        "pep621"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "python dependencies",
      "groupSlug": "python-minor-patch",
      "schedule": [
        "before 3am on monday"
      ]
    },
    {
      "description": "Docker Managers (Dockerfile & Docker Compose)",
      "matchManagers": [
        "dockerfile",
        "docker-compose"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "docker updates",
      "groupSlug": "docker-minor-patch",
      "schedule": [
        "before 3am on monday"
      ]
    },
    {
      "description": "Keep major updates disabled as per original request",
      "matchUpdateTypes": [
        "major"
      ],
      "matchManagers": [
        "npm",
        "pep621",
        "pip_setup",
        "pip-compile"
      ],
      "enabled": false
    }
  ]
}

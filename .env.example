# ===================================
# APPLICATION CONFIGURATION
# ===================================
ENVIRONMENT=development
DEBUG=false

# Python-specific settings (usually don't need to change)
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1

# ===================================
# DATABASE CONFIGURATION
# ===================================
DATABASE_PATH=./data/app.duckdb

# ===================================
# WEB SERVER
# ===================================
HOST=0.0.0.0
PORT=8000

# ===================================
# LOGGING
# ===================================
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ===================================
# API CONFIGURATION
# ===================================
API_TITLE=Varne
API_DESCRIPTION=Varne API
API_VERSION=1.0.0-alpha.0
